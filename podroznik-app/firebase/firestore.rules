rules_version = '2';
// Tripwillow – reguły Firestore.
// 1) Wspólne planowanie (podroznik/sync.js): dane zaszyfrowane w telefonie (AES-256-GCM, klucz tylko w linku zaproszenia).
//    Operacje można tylko dopisywać; odczyt tylko pojedynczego pokoju, którego losowy identyfikator jest w linku.
// 2) Znajomi (podroznik/social.js): profil (imię + klucz publiczny), zaproszenia, czat 1:1 i podróże dla znajomych /
//    publiczne. Czat i podróże są zaszyfrowane end-to-end – serwer przechowuje sam szyfr.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isUid(id) { return id is string && id.size() >= 20 && id.size() <= 40 && id.matches('^[A-Za-z0-9]+$'); }

    match /rooms/{room}/ops/{op} {
      allow list, get: if signedIn();
      allow create: if signedIn()
        && room.size() >= 16 && room.size() <= 32
        && request.resource.data.keys().hasOnly(['by', 't', 'c', 'v'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.t == request.time
        && request.resource.data.c is string
        && request.resource.data.c.size() < 200000
        && request.resource.data.v == 1;
      allow update, delete: if false;
    }

    // profil: czyta każdy zalogowany, ale tylko po identyfikatorze (z linku / QR znajomego); bez listowania
    match /people/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'pub', 'v', 'bio'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 300))
        && request.resource.data.pub is string && request.resource.data.pub.size() <= 300
        && request.resource.data.v == 1;
      allow delete: if signedIn() && request.auth.uid == uid;

      // obserwujący: dokument nazwany identyfikatorem obserwującego; licznik widzi właściciel
      match /followers/{f} {
        allow get: if signedIn() && (request.auth.uid == uid || request.auth.uid == f);
        allow list: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == f && f != uid
          && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t == request.time;
        allow delete: if signedIn() && (request.auth.uid == f || request.auth.uid == uid);
      }

      // zaproszenia / odpowiedzi: dokument nazwany identyfikatorem nadawcy; czyta i usuwa tylko odbiorca
      match /inbox/{from} {
        allow get, list, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == from && from != uid && isUid(uid)
          && request.resource.data.keys().hasOnly(['kind', 'name', 'pub', 't'])
          && request.resource.data.kind in ['req', 'ok', 'bye']
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.pub is string && request.resource.data.pub.size() <= 300
          && request.resource.data.t == request.time;
      }
    }

    // czat 1:1: rozmowa „uidA_uidB” (posortowane) – czytają i piszą tylko te dwie osoby; wiadomości tylko dopisywane
    match /dm/{conv}/msgs/{id} {
      allow get, list: if signedIn() && request.auth.uid in conv.split('_');
      allow create: if signedIn() && request.auth.uid in conv.split('_') && conv.split('_').size() == 2
        && request.resource.data.keys().hasOnly(['by', 't', 'c', 'v'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.t == request.time
        && request.resource.data.c is string && request.resource.data.c.size() < 20000
        && request.resource.data.v == 1;
      allow update: if false;
      // własne wiadomości można usunąć (usunięcie konta)
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }

    // podróże udostępnione: zaszyfrowane migawki; odczyt po identyfikatorze (z listy kluczy albo z linku), pisze tylko właściciel
    match /pub/{uid}/trips/{doc} {
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['c', 't', 'v'])
        && request.resource.data.c is string && request.resource.data.c.size() < 900000
        && request.resource.data.t == request.time && request.resource.data.v == 1;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    // szukanie znajomych po e-mailu (etap 2): dokument = dokładny adres z konta Google zalogowanej osoby; bez listowania
    match /emails/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true
        && email == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // kopia klucza i listy znajomych na koncie (tylko konto Google / Facebook – nie anonimowe); czyta i pisze wyłącznie właściciel
    match /vault/{uid} {
      allow get, create, update, delete: if signedIn() && request.auth.uid == uid
        && request.auth.token.firebase.identities.keys().hasAny(['google.com', 'facebook.com']);
      allow list: if false;
    }
    // znajomi z Facebooka (etap 3): identyfikator Facebooka (przypisany do aplikacji) → profil; zapisuje tylko właściciel tego konta Facebook
    match /fbids/{fbid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && 'facebook.com' in request.auth.token.firebase.identities
        && fbid in request.auth.token.firebase.identities['facebook.com']
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // spis moich podróży publicznych (dla obserwujących) – czyta każdy zalogowany znający identyfikator
    match /pub/{uid}/index/{d} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid && d == 'public'
        && request.resource.data.keys().hasOnly(['name', 't', 'v', 'trips'])
        && request.resource.data.trips is list && request.resource.data.trips.size() <= 50
        && request.resource.data.t == request.time && request.resource.data.v == 1;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    // „Odkrywaj”: podróże publiczne osób, które się na to zgodziły (lista dla wszystkich zalogowanych)
    match /explore/{uid} {
      allow get, list: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 't', 'v', 'trips'])
        && request.resource.data.trips is list && request.resource.data.trips.size() <= 20
        && request.resource.data.t == request.time && request.resource.data.v == 1;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    // lista kluczy podróży dla jednego znajomego (zaszyfrowana kluczem tej pary)
    match /pub/{uid}/keys/{friend} {
      allow get: if signedIn() && (request.auth.uid == uid || request.auth.uid == friend);
      allow list: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && isUid(friend)
        && request.resource.data.keys().hasOnly(['c', 't', 'v'])
        && request.resource.data.c is string && request.resource.data.c.size() < 100000
        && request.resource.data.t == request.time && request.resource.data.v == 1;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
      // ===== Biblioteka planów (biblioteka.js): plany JAWNE (do wyszukiwania), oceny 1–10 – jedna na osobę =====
    function libPath(id) { return /databases/$(database)/documents/library/$(id); }
    function ratePath(id, u) { return /databases/$(database)/documents/library/$(id)/ratings/$(u); }
    function libFields(d) {
      return d.owner is string && d.ownerName is string && d.ownerName.size() <= 40
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 80
        && d.desc is string && d.desc.size() <= 1000
        && d.kind in ['day', 'trip'] && d.days is int && d.days >= 1 && d.days <= 366 && d.month is int && d.month >= 0 && d.month <= 12
        && d.cities is list && d.cities.size() <= 8 && d.countries is list && d.countries.size() <= 12
        && d.tags is list && d.tags.size() <= 80 && d.lang is string && d.lang.size() <= 5
        && d.plan is map && d.t == request.time && d.v == 1;
    }
    // zmiana sumy i liczby ocen musi odpowiadać mojej ocenie zapisanej w tej samej transakcji
    function ratingDeltaOk(id) {
      let u = request.auth.uid;
      let before = exists(ratePath(id, u));
      let after = existsAfter(ratePath(id, u));
      let oldR = before ? get(ratePath(id, u)).data.r : 0;
      let newR = after ? getAfter(ratePath(id, u)).data.r : 0;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount'])
        && request.resource.data.ratingSum == resource.data.ratingSum + newR - oldR
        && request.resource.data.ratingCount == resource.data.ratingCount + (after ? 1 : 0) - (before ? 1 : 0);
    }
    match /library/{id} {
      allow get, list: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner', 'ownerName', 'title', 'desc', 'kind', 'days', 'month', 'cities', 'countries', 'tags', 'lang', 'plan', 'ratingSum', 'ratingCount', 'created', 't', 'v'])
        && libFields(request.resource.data)
        && request.resource.data.ratingSum == 0 && request.resource.data.ratingCount == 0 && request.resource.data.created == request.time;
      allow update: if signedIn() && (
        (resource.data.owner == request.auth.uid && request.resource.data.owner == resource.data.owner
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerName', 'title', 'desc', 'kind', 'days', 'month', 'cities', 'countries', 'tags', 'lang', 'plan', 't'])
          && libFields(request.resource.data))
        || (resource.data.owner != request.auth.uid && ratingDeltaOk(id)));
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /ratings/{u} {
        allow get, list: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == u && get(libPath(id)).data.owner != u
          && request.resource.data.keys().hasOnly(['r', 't'])
          && request.resource.data.r is int && request.resource.data.r >= 1 && request.resource.data.r <= 10
          && request.resource.data.t == request.time
          && getAfter(libPath(id)).data.ratingSum == get(libPath(id)).data.ratingSum + request.resource.data.r - (resource == null ? 0 : resource.data.r)
          && getAfter(libPath(id)).data.ratingCount == get(libPath(id)).data.ratingCount + (resource == null ? 1 : 0);
        // własną ocenę (z poprawką sumy) albo dowolną ocenę planu, którego już nie ma
        allow delete: if signedIn() && (!exists(libPath(id))
          || (request.auth.uid == u
            && getAfter(libPath(id)).data.ratingSum == get(libPath(id)).data.ratingSum - resource.data.r
            && getAfter(libPath(id)).data.ratingCount == get(libPath(id)).data.ratingCount - 1));
      }
    }
    // zgłoszenia nadużyć: tylko dopisywanie; czyta właściciel projektu w konsoli Firebase
    match /reports/{r} {
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['plan', 'by', 'why', 't'])
        && request.resource.data.by == request.auth.uid && request.resource.data.plan is string && request.resource.data.plan.size() <= 40
        && request.resource.data.why is string && request.resource.data.why.size() <= 300 && request.resource.data.t == request.time;
      allow get, list, update, delete: if false;
    }
  }
}
