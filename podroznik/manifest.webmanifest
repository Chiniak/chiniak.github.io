{
  "name": "Tripwillow",
  "short_name": "Tripwillow",
  "description": "Podróże, bilety, plan dnia i lista pakowania w jednym miejscu – działa offline.",
  "lang": "pl",
  "id": "./",
  "start_url": "./index.html#/podroze",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F7F8F6",
  "theme_color": "#F7F8F6",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./udostepnij-do",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            ".pdf",
            "image/*",
            "text/calendar",
            ".ics",
            "application/vnd.apple.pkpass",
            ".pkpass",
            "message/rfc822",
            ".eml",
            "text/plain"
          ]
        }
      ]
    }
  }
}